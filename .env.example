# ---------------------------------------------------------------------------
# Martinez Orlyn Glass & Mirror — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Canonical production origin (no trailing slash). Used for metadata, canonical
# URLs, sitemap.xml, robots.txt and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://www.glassmirrortx.us

# --- Estimate / appointment form delivery (Resend) -------------------------
# Server-only. Leave empty in development: submissions are validated and logged
# to the server console instead of being emailed.
RESEND_API_KEY=
# Verified sending domain in Resend, e.g. "Martinez Orlyn Glass & Mirror <leads@glassmirrortx.us>"
ESTIMATE_FROM_EMAIL=
# Where new leads are delivered. Comma-separated for multiple recipients.
ESTIMATE_TO_EMAIL=martinezorlyn@yahoo.com

# --- Analytics (optional, off until an ID is provided) ----------------------
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Google Tag Manager container ID, e.g. GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# --- Search Console verification (optional) ---------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
